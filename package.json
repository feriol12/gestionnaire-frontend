{
  "name": "front_vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-landing.mjs",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "dev:admin": "vite --config vite.admin.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "test:admin": "vitest run --config vite.admin.config.js && npm run test:admin:isolation",
    "test:admin:isolation": "node --test admin/tests/isolation/client-isolation.test.mjs",
    "test:admin:e2e": "npm run build:admin && playwright test --config admin/tests/e2e/playwright.config.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "prettier": "3.8.1",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
